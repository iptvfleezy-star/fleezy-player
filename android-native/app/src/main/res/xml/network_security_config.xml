<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!--
      Many IPTV/Xtream origins are still HTTP-only, so development currently
      permits cleartext provider traffic. The old Ultra TV updater/telemetry
      endpoints are no longer used by Fleezy Player and are intentionally not
      listed here.

      Before production, prefer a Fleezy-owned HTTPS gateway so credentials
      and provider traffic are protected in transit.
    -->
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system"/>
        </trust-anchors>
    </base-config>
</network-security-config>
